# Copy to `.env` and adjust. Never commit real secrets.
# Every value has a safe default; this file documents them.

# --- Application ---
APP_ENV=dev
APP_LOG_LEVEL=INFO
# MOCK_MODE=true => system uses clearly-marked mock/demo data only.
# There is NO connection to any government database in any mode.
APP_MOCK_MODE=true

# --- Database ---
# Default: sqlite:///<project>/data/app.db  (auto-created on startup)
# Production example:
# APP_DB_URL=postgresql+psycopg://user:password@localhost:5432/screening

# --- CORS (comma-separated allowed origins) ---
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
APP_MAX_UPLOAD_BYTES=10485760

# --- Pipeline ---
# skip = failed stage is reported and the run continues (decision-support
# behavior); fail = abort the whole run on first stage error.
APP_STAGE_FAILURE_POLICY=skip

# --- AI provider selection ---
# Steps 4-5 ship real preprocessing, OCR + validation (cv2-preprocess /
# rapidocr / rule-engine). Set "placeholder" to disable an engine honestly;
# later steps add the rest.
APP_AI_PREPROCESSING_PROVIDER=cv2-preprocess
APP_AI_OCR_PROVIDER=rapidocr
APP_AI_VALIDATION_PROVIDER=rule-engine
# Step 6: forensic tampering heuristics (ELA, noise, grid, copy-move,
# metadata, region cues). "placeholder" disables the module honestly.
APP_AI_TAMPERING_PROVIDER=forensic-heuristics
# Step 7: face verification (YuNet detector + SFace embedding, offline,
# ONE-TO-ONE verification only — never biometric identification against a
# population database). Models: run `python scripts/get_face_models.py`.
# "placeholder" disables the module honestly.
APP_AI_FACE_PROVIDER=cv-face-yunet-sface
# Embedding backend: sface (built-in) | custom registered name | none.
APP_FACE_EMBEDDING_MODEL=sface
# Step 8: risk fusion — deterministic weighted rules (explainable by design).
# "placeholder" disables the module honestly.
APP_AI_RISK_PROVIDER=weighted-rules-v2
# Risk band thresholds on the 0-100 score. POLICY, not fact — tune per
# deployment. Defaults follow the spec example (LOW<=24, MEDIUM<=49, HIGH<=74).
APP_RISK_BAND_LOW_MAX=24
APP_RISK_BAND_MEDIUM_MAX=49
APP_RISK_BAND_HIGH_MAX=74
# Documents expiring within this many days add risk points.
APP_RISK_EXPIRING_SOON_DAYS=90
# Optional trained tampering model (registered via
# app.services.tampering.model.register_tampering_model). "none" = abstain.
APP_AI_TAMPERING_MODEL=none

# --- OCR module (Step 4) ---
# Engine: auto (prefer rapidocr, fall back to tesseract) | rapidocr | tesseract
APP_OCR_ENGINE=auto
APP_OCR_TARGET_WIDTH=1400
APP_OCR_ENABLE_PERSPECTIVE=true
APP_OCR_ENABLE_DENOISE=true
APP_OCR_ENABLE_CONTRAST=true
# Confidence thresholds: fields below 0.75 are flagged for human review;
# documents below 0.70 overall are fully routed to review.
APP_OCR_FIELD_THRESHOLD=0.75
APP_OCR_DOC_THRESHOLD=0.70

# --- Tampering module (Step 6) ---
APP_TAMPERING_MAX_DIMENSION=3000
# Verdict thresholds on the 0-100 fused risk score.
APP_TAMPERING_SUSPICIOUS_MIN=20
APP_TAMPERING_LIKELY_MIN=55

# --- Data retention (days) for uploads/reports ---
APP_RETENTION_DAYS=30

# --- Blockchain audit anchor (Step 9) ---
# Local EVM chain (Hardhat). Stores report HASHES only — never PII.
# When unreachable, anchors honestly stay 'pending'; the DB audit trail
# (audit_events.payload_sha256) is always active.
APP_CHAIN_RPC_URL=http://127.0.0.1:8545
# Empty → resolved from blockchain/deployed.json (written by deploy.js).
APP_CHAIN_CONTRACT_ADDRESS=
# LOCAL TEST ACCOUNTS ONLY (Hardhat accounts are publicly known!).
# Empty → use the node's unlocked coinbase account.
APP_CHAIN_PRIVATE_KEY=

# --- Permissioned ledger backend (Step 10) ---
# Which backend the /api/audit endpoints use. The ledger receives HASHES +
# statuses only — document images, biometric data and personal fields never
# leave the local database.
#   local — in-process mock permissioned ledger (demo/dev; NOT durable across
#           restarts; honestly disclosed in /api/audit/status)
#   evm   — AuditAnchor commitments on the local EVM chain (Hardhat); works
#           against any EVM permissioned ledger
#   auto  — EVM when reachable, otherwise the local mock (disclosed)
# Swapping in Hyperledger Fabric later = implement the same 3-method
# interface (append/get/verify) in app/services/audit/ledger.py.
APP_LEDGER_BACKEND=auto

# --- Security (Step 11) ---
# JWT signing secret. REQUIRED in prod (>= 32 chars; app refuses to start
# without it). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Access-token lifetime (minutes). Short TTL bounds replay risk.
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_JWT_ISSUER=document-screening-system
APP_JWT_AUDIENCE=screening-dashboard

# First ADMIN bootstrap (empty users table only). The password is read from
# the environment ONLY — without it, admin seeding is skipped with a warning.
# Rotate this password immediately after first login (bootstrap tokens expire
# in 60s to force this).
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Brute-force resistance: lock the account after N failed logins.
APP_MAX_FAILED_LOGINS=5
APP_LOCKOUT_MINUTES=15

# Upload retention: per-run upload dirs older than this are deleted on
# startup (data minimization for document images).
APP_UPLOAD_RETENTION_HOURS=24

# Encryption at rest for report_json (OCR fields, MRZ, names). Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in prod (APP_ENCRYPTION_REQUIRED=true); optional-but-warned in dev.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_REQUIRED=true

# Rate limits (per IP): default | auth | upload | analyze
APP_RATE_LIMIT_DEFAULT=120/minute
APP_RATE_LIMIT_AUTH=10/minute
APP_RATE_LIMIT_UPLOAD=30/minute
APP_RATE_LIMIT_ANALYZE=20/minute

# =====================================================================
# Docker demo deployment (see DEPLOY.md) — server-side .env only.
# NEVER commit the real .env. Generate secrets on the server:
#   APP_SECRET_KEY:      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   APP_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================================
# Public hostname Caddy serves (DNS name → Let's Encrypt HTTPS;
# raw IP → HTTP on port 80; unset → demo.localhost local testing):
# DOMAIN=demo.example.com
# Comma-separated browser origins allowed by the API (match DOMAIN):
# APP_CORS_ORIGINS=https://demo.example.com

# --- blockchain/Dockerfile optional hardhat cache tuning ---
# (no secrets; defaults are fine)
